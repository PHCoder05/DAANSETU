# ═══════════════════════════════════════════════════════════════════
# DAANSETU Mobile App - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# API CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
# Base URL of your API server (without /api suffix)
API_BASE_URL=http://10.0.2.2:5000

# For Android Emulator: http://10.0.2.2:5000
# For iOS Simulator: http://localhost:5000
# For Physical Device: http://192.168.x.x:5000 (your computer's IP)

# ─────────────────────────────────────────────────────────────────────
# SOCKET CONFIGURATION (Optional)
# If not set, uses API_BASE_URL
# ─────────────────────────────────────────────────────────────────────
SOCKET_URL=http://10.0.2.2:5000

# ─────────────────────────────────────────────────────────────────────
# GOOGLE MAPS (Optional - for location features)
# ─────────────────────────────────────────────────────────────────────
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
