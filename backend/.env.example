# ═══════════════════════════════════════════════════════════════════
# DAANSETU API - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────────────────────────────
# DATABASE (MongoDB)
# ─────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/daansetu
DB_NAME=daansetu

# ─────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────
# CORS & API
# ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
API_URL=http://localhost:5000/api

# ─────────────────────────────────────────────────────────────────────
# ADMIN SETUP
# Used for initial admin creation - CHANGE IN PRODUCTION!
# ─────────────────────────────────────────────────────────────────────
ADMIN_SETUP_KEY=change-this-setup-key-in-production

# ─────────────────────────────────────────────────────────────────────
# LOGGING
# Levels: error, warn, info, http, verbose, debug, silly
# ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────
# FILE UPLOADS
# ─────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./public/uploads

# ─────────────────────────────────────────────────────────────────────
# EMAIL (SMTP Configuration)
# Required for: password reset, email verification
# Without these, falls back to Ethereal (test emails, not delivered)
# ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="DAANSETU Support" <noreply@daansetu.com>

# ─────────────────────────────────────────────────────────────────────
# FRONTEND URL (for email links)
# ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://daansetu.vercel.app

# ─────────────────────────────────────────────────────────────────────
# NGO VERIFICATION APIs
# For automated verification before admin approval
# Get keys from: surepass.io, attestr.com, or similar providers
# ─────────────────────────────────────────────────────────────────────

# NGO Darpan Verification (NITI Aayog)
DARPAN_API_KEY=your-darpan-api-key
DARPAN_API_URL=https://api.surepass.io/api/v1/ngo-darpan/verify

# 80G/12A Certificate Verification (Income Tax)
IT_VERIFY_API_KEY=your-income-tax-api-key
IT_VERIFY_API_URL=https://api.surepass.io/api/v1/80g/verify

# MCA Company Verification (Section 8 companies)
MCA_API_KEY=your-mca-api-key
MCA_API_URL=https://api.attestr.com/post/mca/company
